{% extends 'layouts/app.jinja2' %}
{% import 'macros/form.jinja2' as f with context %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Editar <Singular> {{ <singular>.<link_column> }}{% endblock %}

{% block topbar_actions %}
    {{ topbar.page('Editar <Singular> ' + <singular>.<link_column>) }}
{% endblock %}

{% block content %}
    {% call f.card() %}
        {% set form_kwargs = {'<singular>_id': <singular>.id} %}
        {% call f.form_tag('<blueprint>.edit', fid='<singular>_form', **form_kwargs) %}
            {% call f.form_group(form.clave) %}{% endcall %}
            {% call f.form_group(form.nombre) %}{% endcall %}
            {% call f.form_group(form.<parent>) %}{% endcall %}
            {% call f.form_group(form.es_algo) %}{% endcall %}
            {% call f.form_group(form.guardar) %}{% endcall %}
        {% endcall %}
    {% endcall %}
{% endblock %}
