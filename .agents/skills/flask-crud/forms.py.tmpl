"""
<Plural>, formularios
"""

from flask_wtf import FlaskForm
from wtforms import BooleanField, SelectField, StringField, SubmitField
from wtforms.validators import DataRequired, Length, Optional, Regexp

from pjecz_hercules_beta_flask.blueprints.<blueprint>.models import <Model>  # Solo si hay un Enum con opciones
from pjecz_hercules_beta_flask.blueprints.<parent_blueprint>.models import <Parent>  # (Segundo nivel)
from pjecz_hercules_beta_flask.lib.safe_string import CLAVE_REGEXP  # Solo para claves de hasta 16 caracteres


class <Model>Form(FlaskForm):
    """Formulario <Model>"""

    # Clave de hasta 16 caracteres
    clave = StringField("Clave (única de hasta 16 caracteres)", validators=[DataRequired(), Regexp(CLAVE_REGEXP)])
    # Clave más larga, por ejemplo String(64)
    # clave = StringField("Clave", validators=[DataRequired(), Length(max=64)])
    nombre = StringField("Nombre", validators=[DataRequired(), Length(max=256)])
    nombre_corto = StringField("Nombre corto", validators=[Optional(), Length(max=64)])
    # Enum con un diccionario de opciones en el modelo
    proposito = SelectField("Propósito", choices=<Model>.PROPOSITOS.items(), validators=[DataRequired()])
    # (Segundo nivel) Padre con id entero
    <parent> = SelectField("<Parent label>", coerce=int, validators=[DataRequired()])
    # (Segundo nivel) Padre con id UUID
    # <parent> = SelectField("<Parent label>", coerce=str, validators=[DataRequired()])
    es_algo = BooleanField("Es algo", validators=[Optional()])
    guardar = SubmitField("Guardar")

    def __init__(self, *args, **kwargs):
        """Inicializar y cargar opciones en <parent>"""
        super().__init__(*args, **kwargs)
        # Padre con id entero
        self.<parent>.choices = [
            (p.id, p.<parent_label_column>)
            for p in <Parent>.query.filter_by(estatus="A").order_by(<Parent>.<parent_label_column>).all()
        ]
