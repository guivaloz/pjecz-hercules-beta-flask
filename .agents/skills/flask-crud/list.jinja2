{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {# Opcional: botones a catálogos relacionados #}
        {% if current_user.can_view('<PARENT_MODULO>') %}
            {{ topbar.button('<Parent plural>', url_for('<parent_blueprint>.list_active'), 'mdi mdi-<icon>') }}
        {% endif %}
        {% if current_user.can_admin('<MODULO>') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('<blueprint>.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('<blueprint>.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('<MODULO>') %}
            {{ topbar.button_new('<Nuevo> <Singular>', url_for('<blueprint>.new')) }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros <Plural> -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtros<PluralCamel>.buscar(); return false;">
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtro<SingularCamel>Clave" type="text" class="form-control" aria-label="Clave" style="text-transform: uppercase;">
                            <label for="filtro<SingularCamel>Clave">Clave</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtro<SingularCamel>Nombre" type="text" class="form-control" aria-label="Nombre" style="text-transform: uppercase;">
                            <label for="filtro<SingularCamel>Nombre">Nombre</label>
                        </div>
                    </div>
                    <div class="col-6 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtros<PluralCamel>.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtros<PluralCamel>.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable <Plural> -->
        <table id="<blueprint>_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Clave</th>
                    <th>Nombre</th>
                    <th><Parent label></th>
                    <th><span title="Es algo">Es A.</span></th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable <Plural>
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDT<PluralCamel> = constructorDataTable.config();
        configDT<PluralCamel>['ajax']['url'] = "{{ url_for('<blueprint>.datatable_json') }}";
        configDT<PluralCamel>['ajax']['data'] = {{ filtros }};
        configDT<PluralCamel>['columns'] = [
            { data: 'detalle' },
            { data: 'nombre' },
            { data: '<parent>_clave' },
            { data: 'es_algo' }
        ];
        configDT<PluralCamel>['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.<link_column> + '</a>';
                }
            },
            {
                targets: 1, // nombre
                data: null,
                render: function(data, type, row, meta) {
                    return (data.length > 32 ? data.substring(0, 32) + '…' : data);
                }
            },
            {
                targets: 3, // es_algo
                data: null,
                render: function(data, type, row, meta) {
                    if (data) { return 'SI'; } else { return ''; }
                }
            }
        ];
        // Filtros <Plural>
        const filtros<PluralCamel> = new FiltrosDataTable('#<blueprint>_datatable', configDT<PluralCamel>);
        filtros<PluralCamel>.agregarInput('filtro<SingularCamel>Clave', 'clave');
        filtros<PluralCamel>.agregarInput('filtro<SingularCamel>Nombre', 'nombre');
        filtros<PluralCamel>.precargar();
    </script>
{% endblock %}
