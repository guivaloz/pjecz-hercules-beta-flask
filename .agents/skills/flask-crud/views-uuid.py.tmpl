"""
<Plural>, vistas
"""

import json

from flask import Blueprint, flash, redirect, render_template, request, url_for
from flask_login import current_user, login_required

from pjecz_hercules_beta_flask.blueprints.bitacoras.models import Bitacora
from pjecz_hercules_beta_flask.blueprints.<blueprint>.forms import <Model>Form
from pjecz_hercules_beta_flask.blueprints.<blueprint>.models import <Model>
from pjecz_hercules_beta_flask.blueprints.modulos.models import Modulo
from pjecz_hercules_beta_flask.blueprints.permisos.models import Permiso
from pjecz_hercules_beta_flask.blueprints.usuarios.decorators import permission_required
from pjecz_hercules_beta_flask.lib.datatables import get_datatable_parameters, output_datatable_json
from pjecz_hercules_beta_flask.lib.safe_string import safe_clave, safe_message, safe_string, safe_uuid

MODULO = "<MODULO>"

<blueprint> = Blueprint("<blueprint>", __name__, template_folder="templates")


@<blueprint>.before_request
@login_required
@permission_required(MODULO, Permiso.VER)
def before_request():
    """Permiso por defecto"""


@<blueprint>.route("/<blueprint>/datatable_json", methods=["GET", "POST"])
def datatable_json():
    """DataTable JSON para listado de <Plural>"""
    # Tomar parámetros de Datatables
    draw, start, rows_per_page = get_datatable_parameters()
    # Consultar
    consulta = <Model>.query
    # Primero filtrar por columnas propias
    if "estatus" in request.form:
        consulta = consulta.filter(<Model>.estatus == request.form["estatus"])
    else:
        consulta = consulta.filter(<Model>.estatus == "A")
    # (Segundo nivel) Filtrar por el id del padre (UUID)
    if "<parent>_id" in request.form:
        <parent>_id = safe_uuid(request.form["<parent>_id"])
        if <parent>_id != "":
            consulta = consulta.filter(<Model>.<parent>_id == <parent>_id)
    if "clave" in request.form:
        try:
            clave = safe_clave(request.form["clave"], max_len=64)
            if clave != "":
                consulta = consulta.filter(<Model>.clave.contains(clave))
        except ValueError:
            pass
    if "descripcion" in request.form:
        descripcion = safe_string(request.form["descripcion"], save_enie=True)
        if descripcion != "":
            consulta = consulta.filter(<Model>.descripcion.contains(descripcion))
    # Ordenar y paginar
    registros = consulta.order_by(<Model>.<order_column>).offset(start).limit(rows_per_page).all()
    total = consulta.count()
    # Elaborar datos para DataTable
    data = []
    for resultado in registros:
        data.append(
            {
                "detalle": {
                    "<link_column>": resultado.<link_column>,
                    "url": url_for("<blueprint>.detail", <singular>_id=resultado.id),
                },
                "descripcion": resultado.descripcion,
                # (Segundo nivel) Columna aplanada del padre
                "<parent>_clave": resultado.<parent>.clave,
            }
        )
    # Entregar JSON
    return output_datatable_json(draw, total, data)


@<blueprint>.route("/<blueprint>")
def list_active():
    """Listado de <Plural> <activos>"""
    return render_template(
        "<blueprint>/list.jinja2",
        filtros=json.dumps({"estatus": "A"}),
        titulo="<Plural>",
        estatus="A",
    )


@<blueprint>.route("/<blueprint>/inactivos")
@permission_required(MODULO, Permiso.ADMINISTRAR)
def list_inactive():
    """Listado de <Plural> <inactivos>"""
    return render_template(
        "<blueprint>/list.jinja2",
        filtros=json.dumps({"estatus": "B"}),
        titulo="<Plural> <inactivos>",
        estatus="B",
    )


@<blueprint>.route("/<blueprint>/<<singular>_id>")
def detail(<singular>_id):
    """Detalle de <un> <Singular>"""
    <singular>_id = safe_uuid(<singular>_id)
    if <singular>_id == "":
        flash("ID de <Singular> inválido", "warning")
        return redirect(url_for("<blueprint>.list_active"))
    <singular> = <Model>.query.get_or_404(<singular>_id)
    return render_template("<blueprint>/detail.jinja2", <singular>=<singular>)


@<blueprint>.route("/<blueprint>/nuevo", methods=["GET", "POST"])
@permission_required(MODULO, Permiso.CREAR)
def new():
    """<Nuevo> <Singular>"""
    form = <Model>Form()
    if form.validate_on_submit():
        es_valido = True
        # Validar que la clave no se repita
        clave = safe_clave(form.clave.data, max_len=64)
        if <Model>.query.filter_by(clave=clave).first():
            flash("La clave ya está en uso. Debe de ser única.", "warning")
            es_valido = False
        # Si es válido, guardar
        if es_valido is True:
            <singular> = <Model>(
                clave=clave,
                descripcion=safe_string(form.descripcion.data, save_enie=True),
                <parent>_id=form.<parent>.data,  # (Segundo nivel)
            )
            <singular>.save()
            bitacora = Bitacora(
                modulo=Modulo.query.filter_by(nombre=MODULO).first(),
                usuario=current_user,
                descripcion=safe_message(f"<Nuevo> <Singular> {<singular>.<link_column>}"),
                url=url_for("<blueprint>.detail", <singular>_id=<singular>.id),
            )
            bitacora.save()
            flash(bitacora.descripcion, "success")
            return redirect(bitacora.url)
    return render_template("<blueprint>/new.jinja2", form=form)


@<blueprint>.route("/<blueprint>/edicion/<<singular>_id>", methods=["GET", "POST"])
@permission_required(MODULO, Permiso.MODIFICAR)
def edit(<singular>_id):
    """Editar <Singular>"""
    <singular>_id = safe_uuid(<singular>_id)
    if <singular>_id == "":
        flash("ID de <Singular> inválido", "warning")
        return redirect(url_for("<blueprint>.list_active"))
    <singular> = <Model>.query.get_or_404(<singular>_id)
    form = <Model>Form()
    if form.validate_on_submit():
        es_valido = True
        # Si cambia la clave verificar que no este en uso
        clave = safe_clave(form.clave.data, max_len=64)
        if <singular>.clave != clave:
            <singular>_existente = <Model>.query.filter_by(clave=clave).first()
            if <singular>_existente and <singular>_existente.id != <singular>.id:
                es_valido = False
                flash("La clave ya está en uso. Debe de ser única.", "warning")
        # Si es válido, actualizar
        if es_valido:
            <singular>.clave = clave
            <singular>.descripcion = safe_string(form.descripcion.data, save_enie=True)
            <singular>.<parent>_id = form.<parent>.data  # (Segundo nivel)
            <singular>.save()
            bitacora = Bitacora(
                modulo=Modulo.query.filter_by(nombre=MODULO).first(),
                usuario=current_user,
                descripcion=safe_message(f"Editado <Singular> {<singular>.<link_column>}"),
                url=url_for("<blueprint>.detail", <singular>_id=<singular>.id),
            )
            bitacora.save()
            flash(bitacora.descripcion, "success")
            return redirect(bitacora.url)
    form.clave.data = <singular>.clave
    form.descripcion.data = <singular>.descripcion
    form.<parent>.data = str(<singular>.<parent>_id)  # Se manda <parent>_id porque es un select
    return render_template("<blueprint>/edit.jinja2", form=form, <singular>=<singular>)


