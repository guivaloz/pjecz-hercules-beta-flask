{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_admin('AUDIENCIAS') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('audiencias.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('audiencias.list_active')) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros Audiencias -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosAudiencias.buscar(); return false;">
                    <div class="col-4">
                        <div class="form-floating">
                            <input id="filtroClave" type="text" class="form-control" aria-label="Clave" style="text-transform: uppercase;">
                            <label for="filtroClave">Clave</label>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-floating">
                            <input id="filtroDescripcion" type="text" class="form-control" aria-label="Descripción" style="text-transform: uppercase;">
                            <label for="filtroDescripcion">Descripción</label>
                        </div>
                    </div>
                    <div class="col-2 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosAudiencias.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosAudiencias.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable Audiencias -->
        <table id="audiencias_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Tipo de audiencia</th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="{{ url_for('static', filename='js/datatables-constructor.js') }}"></script>
    <script src="{{ url_for('static', filename='js/datatables-filtros.js') }}"></script>
    <script>
        // DataTable Audiencias
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDataTable = constructorDataTable.config();
        configDTAudiencias['ajax']['url'] = "{{ url_for('audiencias.datatable_json') }}";
        configDTAudiencias['ajax']['data'] = {{ filtros }};
        configDTAudiencias['columns'] = [
            { data: 'tiempo' },
            { data: 'detalle' }
        ];
        configDTAudiencias['columnDefs'] = [
          {
              targets: 0,
              type: "date",
              render: function (data, type, row) {
                  return data;
              }
          },
          {
              targets: 1,
              data: null,
              render: function(data, type, row, meta) {
                  return '<a href="' + data.url + '">' + data.tipo_audiencia + '</a>';
              }
          }
        ];
        // Filtros Audiencias
        const filtrosAudiencias = new FiltrosDataTable('#audiencias_datatable', configDTAudiencias);
        filtrosAudiencias.agregarInput('filtroClave', 'clave');
        filtrosAudiencias.agregarInput('filtroDescripcion', 'descripcion');
        filtrosAudiencias.precargar();
    </script>
{% endblock %}
