{% extends 'layouts/app.jinja2' %}
{% import 'macros/detail.jinja2' as detail %}
{% import 'macros/modals.jinja2' as modals %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}Estrado{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons('Estrado') %}
        {# Ir al listado activos #}
        {{ topbar.button_previous('Estrados', url_for('estrados.list_active')) }}
        {# Los administradores pueden subir a la autoridad que tienen a la vista #}
        {% if current_user.can_admin('ESTRADOS') %}
            {{ topbar.button_previous('Estrados del ' + estrado.autoridad.clave, url_for('estrados.list_active') + '?autoridad_clave=' + estrado.autoridad.clave) }}
            {{ topbar.button_upload('Subir Estrado para ' + estrado.autoridad.clave, url_for('estrados.new_with_autoridad_id', autoridad_id=estrado.autoridad_id)) }}
        {% elif current_user.can_insert('ESTRADOS') and current_user.autoridad_id == estrado.autoridad_id %}
            {{ topbar.button_upload('Subir Estrado', url_for('estrados.new')) }}
        {% else %}
            {{ topbar.button_previous('Estrado del ' + estrado.autoridad.clave, url_for('estrados.list_active')) }}
        {% endif %}
        {# Los usuarios que pueden editar, eliminar y recuperar si les pertenece o si son administradores #}
        {% if current_user.can_admin('ESTRADOS') or (current_user.can_edit('ESTRADOS') and current_user.autoridad_id == estrado.autoridad_id) %}
            {{ topbar.button_edit('Editar', url_for('estrados.edit', estrado_id=estrado.id)) }}
        {% endif %}
        {% if current_user.can_admin('ESTRADOS') or (current_user.can_insert('ESTRADOS') and current_user.autoridad_id == estrado.autoridad_id) %}
            {% if estrado.estatus == 'A' %}{{ topbar.button_delete('Eliminar', url_for('estrados.delete', estrado_id=estrado.id)) }}{% endif %}
            {% if estrado.estatus == 'B' %}{{ topbar.button_recover('Recuperar', url_for('estrados.recover', estrado_id=estrado.id)) }}{% endif %}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call detail.card(estatus=estrado.estatus) %}
        {{ detail.label_value_big('Descripción', estrado.descripcion) }}
        {{ detail.label_value('Distrito', estrado.autoridad.distrito.nombre) }}
        {% if current_user.can_view("AUTORIDADES") %}
            {{ detail.label_value('Autoridad', estrado.autoridad.descripcion, url_for('autoridades.detail', autoridad_id=estrado.autoridad_id)) }}
        {% else %}
            {{ detail.label_value('Autoridad', estrado.autoridad.descripcion) }}
        {% endif %}
        {{ detail.label_value('Fecha', moment(estrado.fecha, local=True).format("DD MMM YYYY")) }}
        {{ detail.label_value('Creado', moment(estrado.creado).format('llll')) }}
        <div class="row">
            <div class="col">
                {{ detail.button_md(label='Descargar', url=url_for('estrados.download_file_pdf', estrado_id=estrado.id), icon='mdi mdi-download') }}
            </div>
        </div>
    {% endcall %}
    {% call detail.card() %}
        <object data="{{ url_for('estrados.view_file_pdf', estrado_id=estrado.id) }}" type="application/pdf" width="100%" height="600px">
            <p class="mb-0">El navegador no puede mostrar el archivo PDF o no existe en el depósito.</p>
        </object>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    {% if current_user.can_admin('ESTRADOS') %}
        {% if estrado.estatus == 'A' %}{{ modals.custom_javascript_delete('Eliminar', '¿Eliminar a ' + estrado.descripcion + '?') }}{% endif %}
        {% if estrado.estatus == 'B' %}{{ modals.custom_javascript_recover('Recuperar', '¿Recuperar a ' + estrado.descripcion + '?') }}{% endif %}
    {% endif %}
{% endblock %}
