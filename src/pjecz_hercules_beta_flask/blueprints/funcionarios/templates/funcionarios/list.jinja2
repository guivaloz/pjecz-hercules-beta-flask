{% extends 'layouts/app.jinja2' %}
{% import 'macros/list.jinja2' as list %}
{% import 'macros/topbar.jinja2' as topbar %}

{% block title %}{{ titulo }}{% endblock %}

{% block topbar_actions %}
    {% call topbar.page_buttons(titulo) %}
        {% if current_user.can_view('CENTROS TRABAJOS') %}
            {{ topbar.button('Centros de Trabajo', url_for('centros_trabajos.list_active'), 'mdi mdi-office-building') }}
        {% endif %}
        {% if current_user.can_admin('FUNCIONARIOS') %}
            {% if estatus == 'A' %}{{ topbar.button_list_inactive('Inactivos', url_for('funcionarios.list_inactive')) }}{% endif %}
            {% if estatus == 'B' %}{{ topbar.button_list_active('Activos', url_for('funcionarios.list_active')) }}{% endif %}
        {% endif %}
        {% if current_user.can_insert('FUNCIONARIOS') %}
            {{ topbar.button_new('Nuevo Funcionario', url_for('funcionarios.new')) }}
        {% endif %}
    {% endcall %}
{% endblock %}

{% block content %}
    {% call list.card() %}
        <!-- Filtros Funcionarios -->
        <div class="row">
            <div class="col">
                <form class="row g-1 mb-3" id="filtradorForm" onsubmit="filtrosFuncionarios.buscar(); return false;">
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroFuncionarioCurp" type="text" class="form-control" aria-label="CURP" style="text-transform: uppercase;">
                            <label for="filtroFuncionarioCurp">CURP</label>
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroFuncionarioNombres" type="text" class="form-control" aria-label="Nombres" style="text-transform: uppercase;">
                            <label for="filtroFuncionarioNombres">Nombres</label>
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroFuncionarioApellidoPaterno" type="text" class="form-control" aria-label="Apellido paterno" style="text-transform: uppercase;">
                            <label for="filtroFuncionarioApellidoPaterno">Apellido paterno</label>
                        </div>
                    </div>
                    <div class="col-2">
                        <div class="form-floating">
                            <input id="filtroFuncionarioPuesto" type="text" class="form-control" aria-label="Puesto" style="text-transform: uppercase;">
                            <label for="filtroFuncionarioPuesto">Puesto</label>
                        </div>
                    </div>
                    <div class="col-4 text-end">
                        <button title="Buscar" class="btn btn-primary btn-lg" onclick="filtrosFuncionarios.buscar(); return false;" id="button-buscar"><span class="mdi mdi-magnify"></span></button>
                        <button title="Limpiar" class="btn btn-warning btn-lg" type="reset" onclick="filtrosFuncionarios.limpiar();" id="button-limpiar"><span class="mdi mdi-broom"></span></button>
                    </div>
                </form>
            </div>
        </div>
        <!-- DataTable Funcionarios -->
        <table id="funcionarios_datatable" class="table {% if estatus == 'B'%}table-dark{% endif %} display nowrap" style="width:100%">
            <thead>
                <tr>
                    <th>CURP</th>
                    <th>Nombre</th>
                    <th>Puesto</th>
                    <th>Centro de Trabajo</th>
                    <th>e-mail</th>
                    <th><span title="En funciones">En F.</span></th>
                </tr>
            </thead>
        </table>
    {% endcall %}
{% endblock %}

{% block custom_javascript %}
    <script src="/static/js/datatables-constructor.js"></script>
    <script src="/static/js/datatables-filtros.js"></script>
    <script>
        // DataTable Funcionarios
        const constructorDataTable = new ConfigDataTable( '{{ csrf_token() }}' );
        let configDTFuncionarios = constructorDataTable.config();
        configDTFuncionarios['ajax']['url'] = "{{ url_for('funcionarios.datatable_json') }}";
        configDTFuncionarios['ajax']['data'] = {{ filtros }};
        configDTFuncionarios['columns'] = [
            { data: 'detalle' },
            { data: 'nombre' },
            { data: 'puesto' },
            { data: 'centro_trabajo_clave' },
            { data: 'email' },
            { data: 'en_funciones' }
        ];
        configDTFuncionarios['columnDefs'] = [
            {
                targets: 0, // detalle
                data: null,
                render: function(data, type, row, meta) {
                    return '<a href="' + data.url + '">' + data.curp + '</a>';
                }
            },
            {
                targets: [1, 3], // nombre, puesto
                data: null,
                render: function(data, type, row, meta) {
                    return (data.length > 32 ? data.substring(0, 32) + '…' : data);
                }
            },
            {
                targets: 5, // en_funciones
                data: null,
                render: function(data, type, row, meta) {
                    if (data) { return 'SI'; } else { return ''; }
                }
            }
        ];
        // Filtros Funcionarios
        const filtrosFuncionarios = new FiltrosDataTable('#funcionarios_datatable', configDTFuncionarios);
        filtrosFuncionarios.agregarInput('filtroFuncionarioCurp', 'curp');
        filtrosFuncionarios.agregarInput('filtroFuncionarioNombres', 'nombres');
        filtrosFuncionarios.agregarInput('filtroFuncionarioApellidoPaterno', 'apellido_paterno');
        filtrosFuncionarios.agregarInput('filtroFuncionarioPuesto', 'puesto');
        filtrosFuncionarios.precargar();
    </script>
{% endblock %}
